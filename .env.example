# Aus Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Push-Benachrichtigungen (VAPID-Schlüssel, z. B. mit `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://kaarster-billiard-club.vercel.app
# Geheimer Wert, mit dem sich der Server beim Abrufen der Push-Empfänger ausweist (SHA-256 steht in der Datenbank)
PUSH_CLAIM_SECRET=
